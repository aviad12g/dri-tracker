# DRI Tracker Environment Configuration
# Copy this file to .env and fill in your values

# ======================
# DATABASE
# ======================
DATABASE_URL=postgresql://postgres:password@localhost:5432/dri_tracker

# ======================
# API KEYS
# ======================

# YouTube Data API v3
# Get from: https://console.cloud.google.com/apis/credentials
YOUTUBE_API_KEY=your_youtube_api_key_here

# Telegram MTProto API
# Get from: https://my.telegram.org
TELEGRAM_API_ID=your_telegram_api_id_here
TELEGRAM_API_HASH=your_telegram_api_hash_here
TELEGRAM_SESSION_NAME=dri_tracker

# Optional: X/Twitter API (if available)
# X_BEARER_TOKEN=your_x_bearer_token_here

# Optional: TikTok API (if available)
# TIKTOK_API_KEY=your_tiktok_api_key_here

# ======================
# APPLICATION SETTINGS
# ======================

# Rolling window for Z-score normalization (days)
ROLLING_WINDOW_DAYS=90

# Spike detection threshold (standard deviations)
SPIKE_THRESHOLD_SIGMA=2.0

# Default region for search interest
DEFAULT_REGION=US

# API server settings
API_HOST=0.0.0.0
API_PORT=8000

# Frontend URL (for CORS)
FRONTEND_URL=http://localhost:3000

# ======================
# ADMIN ACCESS
# ======================
# Simple local admin password for event management
ADMIN_PASSWORD=change_this_password

# ======================
# LOGGING
# ======================
LOG_LEVEL=INFO


