# All optional. See README.md.

# Free key from https://console.cloud.google.com/apis/credentials (YouTube Data API v3).
# Records lifetime channel views, which the Engagement pillar needs.
YOUTUBE_API_KEY=

# Optional. Without it X is read through a free third-party mirror (api.fxtwitter.com).
# With it the official API is used instead: paid, about $0.01 per account per day.
X_BEARER_TOKEN=

# Set to off to stop using the free X mirror.
DRI_X_MIRROR=

# Identify yourself to the sites you read; include a contact address.
DRI_USER_AGENT=
