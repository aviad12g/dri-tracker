# All optional. See README.md.

# Free key from https://console.cloud.google.com/apis/credentials (YouTube Data API v3).
# Records lifetime channel views, which the Engagement pillar needs.
YOUTUBE_API_KEY=

# Paid, pay-per-use (about $0.01 per account per day). Enables the X collector.
X_BEARER_TOKEN=

# Identify yourself to the sites you read; include a contact address.
DRI_USER_AGENT=
